# Copy to .env and replace values. In bash, load it with:
# set -a; source .env; set +a
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-change-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_TRUST_PROXY_SSL_HEADER=false
FRONTEND_BASE_URL=http://localhost:5173

# Leave POSTGRES_DB empty to use SQLite locally. Set all PostgreSQL values
# together to use PostgreSQL locally; production (DJANGO_DEBUG=false) requires them.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
# Optional; use the value required by your database host, such as "require".
POSTGRES_SSLMODE=

# Optional legacy/local MongoDB mode. PostgreSQL takes precedence when configured.
MONGODB_URI=
MONGODB_NAME=kiddies_droid

# Resend SMTP values (ignored by the console backend while DJANGO_DEBUG=true).
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL="Kiddies Droid Portal <no-reply@kiddiesdroid.org>"
